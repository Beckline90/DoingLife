{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "App": {
    "BaseUrl": "https://localhost:7135",
    "FrontendUrl": "http://localhost:3000"
  },
  "Jwt": {
    "Issuer": "DoingLife.WebApi",
    "Audience": "DoingLife.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}